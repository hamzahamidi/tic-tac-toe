{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "cypress"]
  },
  "include": ["cypress.config.ts", "cypress/**/*.ts", "infra/**/*.ts"]
}
